{
  "name": "umb-campus-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phone-first 3D UMass Boston campus wayfinding PWA in three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node eval/run-eval.mjs",
    "preview": "vite preview",
    "fetch-osm": "node scripts/fetch-osm.mjs"
  },
  "dependencies": {
    "ical.js": "^2.1.0",
    "pdfjs-dist": "^6.5.438",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@types/three": "^0.177.0",
    "lighthouse": "^13.6.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  }
}
